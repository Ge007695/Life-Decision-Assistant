# Office 临时锁文件
~$*
*.tmp
*.temp

# 预览渲染件（排版校对用，不进仓库）
output/*/working/*.png
output/*/working/*.pdf

# 本地记忆与工具数据
.workbuddy/

# 依赖与构建产物
node_modules/
dist/
build/
.check-*/
*.local

# 环境与密钥
.env
.env.*
!.env.example

# 数据与缓存
# 原始数据不随仓库分发，仓库只记录数据来源（见 docs/data-source.md）；
# 但回测报表 report.md / irr-report.md 是指导书十三章要求的两份交付物，
# 必须进仓库，所以这里只按扩展名排除中间数据，不整目录排除
scripts/backtest/data/
scripts/backtest/output/**/*.csv
scripts/backtest/output/**/*.json
*.parquet

# 发布平台的本机应用标记文件
.wbapp_*.genie

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 构建中间产物（与最终交付重复）
output/*/working/*.docx

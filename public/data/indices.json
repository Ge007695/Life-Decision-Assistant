{
  "meta": {
    "version": "1.2.0",
    "updated": "2026-11-05",
    "note": "所有阈值、权重、文案集中在本文件。代码里不允许出现未命名的数字。normalize 区间写作 [劣端, 优端]，不是 [min, max]。 每个指数节点带 version，用于 DecisionResult.evidence.configVersion：配置值改了要跟着升，否则报告里看不出结论是哪个配置算的。"
  },
  "indices": {
    "drying": {
      "version": "1.1.0",
      "type": "weighted",
      "label": "晾晒指数",
      "inputs": [
        "temp",
        "humidity",
        "windSpeed",
        "precipProb",
        "solar"
      ],
      "weights": {
        "temp": 0.2,
        "humidity": 0.3,
        "windSpeed": 0.2,
        "precipProb": 0.25,
        "solar": 0.05
      },
      "normalize": {
        "temp": [
          10,
          32
        ],
        "humidity": [
          90,
          40
        ],
        "windSpeed": [
          0,
          5
        ],
        "precipProb": [
          80,
          0
        ],
        "solar": [
          0,
          800
        ]
      },
      "evidenceLabel": {
        "temp": "气温",
        "humidity": "相对湿度",
        "windSpeed": "风速",
        "precipProb": "降水概率",
        "solar": "日照辐射"
      },
      "format": {
        "temp": "{v} ℃",
        "humidity": "{v}%",
        "windSpeed": "{v} m/s",
        "precipProb": "{v}%",
        "solar": "{v} W/m²"
      },
      "bestWindow": {
        "windowHours": 2,
        "minScore": 60,
        "horizonHours": 24,
        "collectBefore": "18:00",
        "noWindowText": "全天不建议"
      },
      "levels": [
        {
          "min": 68,
          "level": 4,
          "label": "适宜",
          "headline": "今天适合晾晒，{bestWindow} 前收衣"
        },
        {
          "min": 55,
          "level": 3,
          "label": "一般",
          "headline": "可以晾，但干得慢，建议延长晾晒时间"
        },
        {
          "min": 35,
          "level": 2,
          "label": "较差",
          "headline": "不建议晾晒，改为室内除湿"
        },
        {
          "min": 0,
          "level": 1,
          "label": "不宜",
          "headline": "今天晾不干，改用烘干或推迟"
        }
      ]
    },
    "damp": {
